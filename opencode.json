{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": [
        "bunx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    },
    "zustand": {
      "type": "remote",
      "url": "https://gitmcp.io/pmndrs/zustand",
      "enabled": true
    },
    "assistant-ui": {
      "type": "remote",
      "url": "https://gitmcp.io/assistant-ui/assistant-ui",
      "enabled": true
    },
    "dual-graph": {
      "type": "remote",
      "url": "http://127.0.0.1:8080/mcp",
      "enabled": true
    }
  }
}
