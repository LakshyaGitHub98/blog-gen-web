# Backend URL — change in public/config.js for runtime, or here for build-time.
# Local dev:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Production (set as GitHub Actions variable or build-time env):
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com

# Standalone demo without backend (mock data):
# NEXT_PUBLIC_MOCK=true
